# URL of the running UrlShortener.Api project (see the companion .NET solution).
# Used both server-side (initial page load) and client-side (create/update/delete/refresh).
#
# Use the API's HTTP endpoint for local dev — Node's server-side fetch (used for the initial
# page load) doesn't trust the ASP.NET Core self-signed dev cert the way a browser does after
# running `dotnet dev-certs https --trust`, so https://localhost:5001 can fail server-side even
# though it works fine from the browser. HTTP sidesteps that entirely for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
